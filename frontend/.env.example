# Identity Platform (Firebase Auth) client configuration.
#
# These are public values baked into the browser bundle -- they identify the
# project, they do not authorise anything. Access is decided by the API, which
# verifies the ID token's signature and audience on every request and refuses
# any token without a tenant_id claim.
#
# Copy to .env.local and fill in from the Firebase console:
#   Project settings -> General -> Your apps -> SDK setup and configuration
#
# Leave them unset for local development against an API started with
# AUTH_DISABLED=1 ENV=local; the app then never asks anyone to sign in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Where the FastAPI service is. Read when `next build` runs, not at boot, so a
# change needs a rebuild.
API_ORIGIN=http://127.0.0.1:8000
