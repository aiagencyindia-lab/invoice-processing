# GCP Configuration
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
PROJECT_ID=your-gcp-project-id
LOCATION=us-central1

# Model Configuration
# Default models: gemini-2.5-flash and gemini-2.5-pro
# Uncomment to override defaults:
# GEMINI_FLASH_MODEL=gemini-2.5-flash
# GEMINI_PRO_MODEL=gemini-2.5-pro

# Rate Limiting (seconds between API calls)
# Default: 1.0 second (good balance for gemini-2.5 models)
# Increase if hitting quota limits, decrease if you have higher quota
# API_CALL_DELAY_SECONDS=1.0

# --- Platform (Phase 1) ----------------------------------------------------
# Authentication. The audience for Identity Platform ID tokens: without it,
# tokens minted for any other Google project would be accepted.
GOOGLE_CLOUD_PROJECT=

# Local development only. Runs every request as an admin dev principal.
# Refuses to activate when ENV is production/prod/staging.
# AUTH_DISABLED=1
# ENV=local

# Inbound email. Both are required before the webhook will accept anything:
# with no secret it returns 503 rather than running open.
INBOUND_WEBHOOK_SECRET=
INBOUND_EMAIL_DOMAIN=invoices.example.com

# Storage and database. Unset means local files and in-memory SQLite.
GCS_BUCKET=
DATABASE_URL=

# Work queue. Both set = Pub/Sub; otherwise a local directory under data/.
PUBSUB_TOPIC=
PUBSUB_SUBSCRIPTION=

# --- Cloud SQL -------------------------------------------------------------
# Set CLOUD_SQL_INSTANCE to connect through the Google connector (no public IP
# and no allowlist needed). It takes precedence over DATABASE_URL.
CLOUD_SQL_INSTANCE=project:region:instance
CLOUD_SQL_DATABASE=postgres
CLOUD_SQL_USER=postgres
# Preferred: the service account authenticates, so there is no password at all.
# CLOUD_SQL_IAM_AUTH=1
# Fallback if IAM auth is not set up on the instance:
CLOUD_SQL_PASSWORD=
# CLOUD_SQL_PRIVATE_IP=1
