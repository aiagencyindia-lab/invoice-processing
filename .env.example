# GCP Configuration
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
PROJECT_ID=your-gcp-project-id
LOCATION=us-central1

# Model Configuration
# Default models: gemini-2.5-flash and gemini-2.5-pro
# Uncomment to override defaults:
# GEMINI_FLASH_MODEL=gemini-2.5-flash
# GEMINI_PRO_MODEL=gemini-2.5-pro

# Rate Limiting (seconds between API calls)
# Default: 1.0 second (good balance for gemini-2.5 models)
# Increase if hitting quota limits, decrease if you have higher quota
# API_CALL_DELAY_SECONDS=1.0

# --- Platform (Phase 1) ----------------------------------------------------
# Authentication uses GOOGLE_CLOUD_PROJECT (set at the top of this file) as the
# audience for Identity Platform ID tokens. Do NOT declare it a second time --
# dotenv lets the later assignment win, so an empty one here silently breaks
# token verification.
#
# Note the asymmetry: the LLM path accepts these aliases, but the auth verifier
# reads GOOGLE_CLOUD_PROJECT alone. Setting only an alias yields a working
# pipeline and a broken login, so prefer GOOGLE_CLOUD_PROJECT above.
# GOOGLE_CLOUD_PROJECT_ID=
# GCP_PROJECT=

# Local development only. Runs every request as an admin dev principal.
# Activates only when ENV is one of the known-local values.
# AUTH_DISABLED=1
# ENV=local
# AUTH_DEV_EMAIL=dev@localhost
# AUTH_DEV_TENANT=default

# Inbound email. Both are required before the webhook will accept anything:
# with no secret it returns 503 rather than running open.
INBOUND_WEBHOOK_SECRET=
INBOUND_EMAIL_DOMAIN=invoices.example.com

# Storage and database. Unset means local files and in-memory SQLite.
GCS_BUCKET=
DATABASE_URL=

# Work queue. Both set = Pub/Sub; otherwise a local directory under data/.
PUBSUB_TOPIC=
PUBSUB_SUBSCRIPTION=

# --- Cloud SQL -------------------------------------------------------------
# Set CLOUD_SQL_INSTANCE to connect through the Google connector (no public IP
# and no allowlist needed). It takes precedence over DATABASE_URL.
CLOUD_SQL_INSTANCE=project:region:instance
CLOUD_SQL_DATABASE=postgres
CLOUD_SQL_USER=postgres
# Preferred: the service account authenticates, so there is no password at all.
# CLOUD_SQL_IAM_AUTH=1
# Fallback if IAM auth is not set up on the instance:
CLOUD_SQL_PASSWORD=
# CLOUD_SQL_PRIVATE_IP=1


# --- Xero export -----------------------------------------------------------
# Access token from the OAuth flow, and the Xero tenant (organisation) id.
# The client secret is deliberately NOT read by this application.
# Unset means the export endpoint answers 503 and CSV export still works.
XERO_ACCESS_TOKEN=
XERO_TENANT_ID=
# JSON object mapping item categories to Xero account codes, e.g. {"freight":"310"}
XERO_ACCOUNT_CODES={}

# --- Model behaviour -------------------------------------------------------
# Seed for the extraction/classification calls; keeps runs reproducible.
# GENERATION_SEED=42
# Region alias read alongside LOCATION.
# GOOGLE_CLOUD_REGION=us-central1

# --- Investigation critic --------------------------------------------------
# Tier 0 runs deterministic checks with no LLM calls. Turning it off restores
# the old LLM-backed layer and its cost.
# CRITIC_DETERMINISTIC_TIER0=1
# CRITIC_LLM_TIMEOUT_SECONDS=120
# CRITIC_MAX_LLM_CALLS=30
# CRITIC_CASE_DEADLINE_SECONDS=600

# --- Sign-up ---------------------------------------------------------------
# Lets an account create its own organisation from /signup, making itself that
# organisation's admin. Off by default and on purpose: everywhere else,
# belonging to a tenant is something an administrator grants, and turning this
# on lets anyone with an email address create a tenant, an inbound-mail
# address and a storage prefix inside the deployment.
# Requires APPLY_IDENTITY_CLAIMS as well, or the claims are a dry run and the
# new account is refused by the system that just provisioned it.
ALLOW_SELF_SIGNUP=
